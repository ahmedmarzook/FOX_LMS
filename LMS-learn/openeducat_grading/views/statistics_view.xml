<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="statistics" model="ir.ui.view">
        <field name="name">assignment.statistics.form</field>
        <field name="model">assignment.statistics</field>
        <field name="arch" type="xml">
            <form string="Assignment Statistics" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="assignment_name"/>
                        <field name="assignment_point"/>
                    </group>
                    <group string="Statistics" col="4">
                        <field name="count"/>
                        <field name="graded"/>
                        <field name="need_grade"/>
                        <field name="minimum_value"/>
                        <field name="maximum_value"/>
                        <field name="sta_range"/>
                        <field name="average"/>
                        <field name="median"/>
                        <field name="std_deviation"/>
                        <field name="variances"/>
                    </group>
                    <group string="Grade Distribution">
                        <field name="grade_distribution" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="assignment_action_view" model="ir.actions.act_window">
        <field name="name">Overview</field>
        <field name="res_model">assignment.statistics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="statistics"/>
        <field name="target">current</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>

	<record id="view_groups_form" model="ir.ui.view">
		<field name="name">res.groups.inherit</field>
		<field name="model">res.groups</field>
		<field name="inherit_id" ref="base.view_groups_form" />
		<field name="arch" type="xml">
			<field name="name" position="after">
				<field name="name2" string="Display Name" />
			</field>
			<notebook position="before">
				<group>
					<field name="allow_delegation" />
					<field name="allow_multiple_delegation" invisible="allow_delegation == False"/>
					<field name="restricted_access" />
				</group>
			</notebook>
			<notebook position="inside">
				<page string="Delegation Email Templates" invisible="allow_delegation == False">
					<group>
						<field name="delegation_template_ids" nolabel="0">
							<list>
								<field name="name" />
								<field name="model_id" />
								<field name="subject" />
							</list>
						</field>
					</group>
				</page>
			</notebook>
		</field>
	</record>

</odoo>

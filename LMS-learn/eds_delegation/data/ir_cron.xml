<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<record id="cron_clear_access_cache" model="ir.cron" forcecreate="False">
		<field name="name">Clear Access Cache</field>
		<field name="user_id" ref="base.user_root" />
		<field name="active" eval="True" />
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="model_id" ref="model_delegation" />
		<field name="state">code</field>
		<field name="code">model._clear_access_cache()</field>
		<field name="nextcall" eval="datetime.today() + relativedelta(days=1,hour=0, second=0, minute=0)" />
	</record>

</odoo>

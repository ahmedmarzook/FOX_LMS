#. module: oi_delegation
#: model:mail.template,body_html:eds_delegation.email_template_delegation
msgid ""
"\n"
"<p>\n"
"<b>Dear ${ctx.get('delegator')}</b>,\n"
"</p>\n"
"<br>\n"
"<p>\n"
"This email is to inform you that during this period \n"
"${object.date_from} to ${object.date_to}, \n"
"you have been delegated the following role/s: ${ctx.get('roles')}.\n"
"</p>    \n"
"<p>\n"
"<b>Best regards,</b>\n"
"</p>  \n"
"\n"
"\t\t\t   \n"
"\n"
"\t\t"
msgstr ""
"<p>\n"
"<b>عزيزي ${ctx.get('delegator')</b>،\n"
"</p>\n"
"<br>\n"
"<p>\n"
"تم إرسال هذا البريد الإلكتروني لإعلامك بأنه خلال هذه الفترة من \n"
"${object.date_from} إلى ${object.date_to}، \n"
"تم تفويضك بالدور/الأدوار التالية: ${ctx.get('roles')}.\n"
"</p>\n"
"<p>\n"
"<b>مع أطيب التحيات،</b>\n"
"</p>"


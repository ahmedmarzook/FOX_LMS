<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_media_unit_tree" model="ir.ui.view">
            <field name="name">op.media.unit.list</field>
            <field name="model">op.media.unit</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Media Units">
                    <field name="name"/>
                    <field name="media_id"/>
                    <field name="barcode"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_media_unit_form" model="ir.ui.view">
            <field name="name">op.media.unit.form</field>
            <field name="model">op.media.unit</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Media Units">
                    <header groups="base.group_user">

                        <button name="%(issue_media_act)d"
                                string="Issue Media"
                                type="action"
                                context="{
                                    'default_media_id': media_id,
                                    'default_media_unit_id': id
                                }"
                                class="oe_highlight"
                                groups="openeducat_library.group_op_library"
                                invisible="state != 'available'"/>

                        <button name="%(return_media_act)d"
                                string="Return Media"
                                type="action"
                                context="{
                                    'default_media_id': media_id,
                                    'default_media_unit_id': id
                                }"
                                class="oe_highlight"
                                groups="openeducat_library.group_op_library"
                                invisible="state != 'issue'"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="available,issue,reserve,lost"/>

                    </header>

                    <sheet>
                        <field name="active" invisible="1"/>

                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="barcode" readonly="1"/>
                            </group>

                            <group>
                                <field name="media_id"/>
                                <field name="media_type_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="movements" string="Movements">
                                <field name="movement_lines" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_media_unit_search" model="ir.ui.view">
            <field name="name">op.media.unit.search</field>
            <field name="model">op.media.unit</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Media Units">
                    <field name="name"/>
                    <field name="barcode"/>
                    <field name="media_id"/>
                </search>
            </field>
        </record>

        <record id="act_open_media_unit_view"
                model="ir.actions.act_window">
            <field name="name">Media Units</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.media.unit</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record id="act_open_media_unit_view_form"
                model="ir.actions.act_window.view">
            <field name="act_window_id"
                   ref="act_open_media_unit_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id"
                   ref="view_media_unit_form"/>
        </record>

        <record id="act_open_media_unit_view_tree"
                model="ir.actions.act_window.view">
            <field name="act_window_id"
                   ref="act_open_media_unit_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id"
                   ref="view_media_unit_tree"/>
        </record>

    </data>
</odoo>
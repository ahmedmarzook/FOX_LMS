<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="view_op_media_queue_tree" model="ir.ui.view">
            <field name="name">op.media.queue.list</field>
            <field name="model">op.media.queue</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Media Queue Request">
                    <field name="name"/>
                    <field name="media_id"/>
                    <field name="user_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_op_media_queue_form" model="ir.ui.view">
            <field name="name">op.media.queue.form</field>
            <field name="model">op.media.queue</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="media Queue Request">
                    <header groups="base.group_user">
                        <button name="do_accept" string="Accept" type="object" class="oe_highlight" groups="openeducat_core.group_op_back_office_admin,openeducat_library.group_op_library" invisible="state != 'request'"/>
                        <button name="do_reject" string="Reject" type="object" groups="openeducat_core.group_op_back_office_admin,openeducat_library.group_op_library" invisible="state not in ['request', 'accept']"/>
                        <button name="do_request_again" string="Request Again" type="object" groups="openeducat_core.group_op_faculty,openeducat_core.group_op_back_office_admin" invisible="state != 'reject'"/>
                        <field name="state" widget="statusbar" statusbar_visible="request,reject,accept" statusbar_colors="{&quot;reject&quot;:&quot;red&quot;}"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="active" invisible="1"/>
                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                            <div style="font-size:20px;font-weight:bold;">
                                <field name="name"/>
                            </div>
                        </group>
                        <group class="pt-3">
                            <group>
                                <field name="user_id" placeholder="Name"/>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="media_id" placeholder="Media"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/></form>
            </field>
        </record>

        <record id="view_op_media_queue_search" model="ir.ui.view">
            <field name="name">op.media.queue.search</field>
            <field name="model">op.media.queue</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Media Queue Request">
                    <field name="user_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                    <field name="media_id"/>
                    </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_media_queue_view">
            <field name="name">Media Queue Requests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.media.queue</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_op_media_queue_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_media_queue_view_form">
            <field name="act_window_id" ref="act_open_op_media_queue_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_media_queue_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_media_queue_view_tree">
            <field name="act_window_id" ref="act_open_op_media_queue_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_media_queue_tree"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_logs_attentive_list" model="ir.ui.view">
        <field name="name">log.attentive.list</field>
        <field name="model">log.attentive</field>
        <field name="arch" type="xml">
            <list>
                <field name="logs_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="time_log"/>
            </list>
        </field>
    </record>

    <record id="view_op_logs_attentive_form" model="ir.ui.view">
        <field name="name">log.attentive.form</field>
        <field name="model">log.attentive</field>
        <field name="arch" type="xml">
            <form string="Attentiveness Log">
                <sheet>
                    <group>
                        <field name="logs_id"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="time_log"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_op_logs_attentive" model="ir.actions.act_window">
        <field name="name">Attentiveness Logs</field>
        <field name="res_model">log.attentive</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_login_as" model="ir.ui.view">
        <field name="name">res.users.form.inherit.login.as</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(act_login_as)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-sign-in"
                        groups="base.group_system">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Login As</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_login_as_form" model="ir.ui.view">
        <field name="name">login.as.from</field>
        <field name="model">login.as</field>
        <field name="arch" type="xml">
            <form>
                <group>                
                	<field name="group_id" options="{'no_create_edit': True}" domain="[('privilege_id.category_id.visible','=', True)]"/>
                    <field name="user_id" options="{'no_create_edit': True}" domain="group_id and [('group_ids','=', group_id), '|', ('active','=', True), ('active','=', False)] or ['|', ('active','=', True), ('active','=', False)]"/>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company" />
                </group>
                <group string="User Groups">
                	<field name="group_ids">
                		<list>
                			<field name="full_name" />
                		</list>
                	</field>
                </group>
                <footer>
                    <button name="switch_to_user" type="object" string="Switch to user" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

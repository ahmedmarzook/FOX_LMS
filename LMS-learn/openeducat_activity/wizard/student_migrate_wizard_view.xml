<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data>

        <!-- FORM VIEW -->
        <record id="student_migrate_form" model="ir.ui.view">
            <field name="name">student.migrate.form</field>
            <field name="model">student.migrate</field>
            <field name="arch" type="xml">

                <form string="Student Migration">

                    <sheet>

                        <group>
                            <group>
                                <field name="date"/>
                                <field name="course_completed"/>
                            </group>
                        </group>

                        <group class="mt-3">

                            <group>
                                <field name="course_from_id"/>
                                <field name="optional_sub"/>
                            </group>

                            <group>
                                <field name="course_to_id"
                                       invisible="course_completed"
                                       required="not course_completed"/>

                                <field name="batch_id"
                                       invisible="course_completed"
                                       required="not course_completed"/>
                            </group>

                        </group>

                        <notebook>

                            <page string="Students">

                                <field name="student_ids"
                                       domain="[('course_detail_ids.course_id', '=', course_from_id)]">

                                    <list>
                                        <field name="name"/>
                                        <field name="middle_name"/>
                                        <field name="last_name"/>
                                    </list>

                                </field>

                            </page>

                        </notebook>

                    </sheet>

                    <footer>

                        <button name="student_migrate_forward"
                                type="object"
                                string="Forward"
                                class="btn-primary"/>

                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>

                    </footer>

                </form>

            </field>
        </record>

        <!-- ACTION -->
        <record id="act_open_student_migrate_view" model="ir.actions.act_window">
            <field name="name">Student Migration</field>
            <field name="res_model">student.migrate</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>

        <!-- VIEW ACTION -->
        <record id="act_open_student_migrate_view_form"
                model="ir.actions.act_window.view">
            <field name="act_window_id" ref="act_open_student_migrate_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="student_migrate_form"/>
        </record>

    </data>

</odoo>
<odoo>
    <record id="view_op_lms_course_tree" model="ir.ui.view">
        <field name="name">op.course.list.lms</field>
        <field name="model">op.course</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Online Courses">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="language" optional="hide"/>
                <field name="level_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="navigation_policy" optional="hide"/>
                <field name="visibility" optional="hide"/>
                <field name="state"/>
                <field name="is_published" widget="boolean_toggle" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_op_lms_course_form" model="ir.ui.view">
        <field name="name">op.course.form.lms</field>
        <field name="model">op.course</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Re-open" type="object" class="oe_highlight"
                            invisible="state != 'closed'"/>
                    <button name="action_closed" string="Closed" type="object" class="oe_highlight"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_section" class="oe_stat_button" icon="fa-book" type="object"
                                groups="openeducat_lms.group_op_lms_admin,openeducat_lms.group_op_lms_user">
                            <field string="Sections" name="section_count" widget="statinfo"/>
                        </button>
                        <button name="action_view_material" type="object" icon="fa-files-o" class="oe_stat_button"
                                groups="openeducat_lms.group_op_lms_admin,openeducat_lms.group_op_lms_user">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="training_material" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Materials</span>
                            </div>
                        </button>
                        <button name="action_course_completed" type="object" icon="fa-trophy" class="oe_stat_button"
                                groups="openeducat_core.group_op_back_office_admin,openeducat_core.group_op_faculty">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="course_completed" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Completed</span>
                            </div>
                        </button>
                        <button name="action_view_users" type="object" icon="fa-users" class="oe_stat_button"
                                groups="openeducat_core.group_op_back_office_admin,openeducat_core.group_op_faculty">
                            <field name="enrolled_users" string="Enrollments" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <field name="online_course" class="oe_edit_only" readonly="1"/>
                        <label class="oe_edit_only" for="online_course" string="Online Course?"/>
                        <h1>
                            <field name="name" placeholder="Course Name"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group>
                            <field name="code" required="1"/>
                            <field name="confirm_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="language"/>
                            <field name="level_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id" invisible="1"/>
                        </group>
                    </group>
                    <group col="4" string="Thumbnail">
                        <field name="thumbnail_type"/>
                        <field name="thumb_url"/>
                        <field name="thumb_video" options="{'accepted_file_extensions': 'video/*'}"/>
                        <field name="thumb_document" invisible="1"/>
                    </group>
                    <notebook>
                        <page name="general" string="General">
                            <group col="2">
                                <group>
                                    <field name="visibility" widget="radio"/>
                                </group>
                                <group>
                                    <field name="navigation_policy" widget="radio"/>
                                </group>
                                <group>
                                    <field name="certificate"/>
                                    <field name="title"/>
                                    <field name="certi_title"/>
                                    <field name="certi_date"/>
                                    <field name="certi_num"/>
                                </group>
                                <group>
                                    <field name="background" widget="image" class="oe_avatar"/>
                                </group>
                            </group>
                            <group string="Short Description">
                                <field name="short_description" colspan="4" nolabel="1"/>
                            </group>
                            <group string="Full Description">
                                <field name="full_description" colspan="4" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Invited Users">
                            <button name="%(act_open_course_invitation_wizard_view)d" string="Invite Users"
                                    type="action" class="oe_highlight"/>
                            <field name="invited_users_ids">
                                <list editable="top">
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </page>
                        <page name="course_materials" string="Course Materials">
                            <group>
                                <field name="total_time" widget="float_time"/>
                            </group>
                            <field name="course_section_ids">
                                <list default_order="sequence">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="total_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page name="faculties" string="Faculties">
                            <field name="faculty_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </page>
                        <page name="suggested_courses" string="Suggested Courses">
                            <field name="suggested_course_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   domain="[('online_course', '=', True)]"/>
                        </page>
                        <page name="categories" string="Categories">
                            <field name="category_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_op_lms_course_search" model="ir.ui.view">
        <field name="name">op.course.search.lms</field>
        <field name="model">op.course</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Online Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="user_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>
    <record id="act_open_op_lms_course_view" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">op.course</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_op_lms_course_search"/>
        <field name="context">{'default_online_course': 1, 'search_default_online_course': 1}</field>
    </record>
    <record id="act_open_op_lms_course_view_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_op_lms_course_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_op_lms_course_tree"/>
    </record>
    <record id="act_open_op_lms_course_view_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_op_lms_course_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_op_lms_course_form"/>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mail_activity_menu_form" model="ir.ui.view">
        <field name="name">mail.activity.menu.form</field>
        <field name="model">mail.activity.menu</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="compute_activity_type" string="Compute Related Document Type" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create' : 1}"/>
                            <field name="model"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="history">
                            <field name="line_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="action_id"/>
                                    <field name="main_menu_id"/>
                                </list>
                            </field>

                        </page>
                        <page string="Code">
                            <field name="code" nolabel="1" widget="code" options="{'mode': 'python'}"/>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mail_activity_menu_tree" model="ir.ui.view">
        <field name="name">mail.activity.menu.tree</field>
        <field name="model">mail.activity.menu</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="model"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mail_activity_menu_search" model="ir.ui.view">
        <field name="name">mail.activity.menu.search</field>
        <field name="model">mail.activity.menu</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
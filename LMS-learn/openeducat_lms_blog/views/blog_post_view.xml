<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_lms_blog_post_list_inherited" model="ir.ui.view">
        <field name="name">lms.blog.post.list.inherit.course</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="after">
                <field name="course_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="blog_post_view_form_add_inherited" model="ir.ui.view">
        <field name="name">blog.post.form.inherit.course</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.blog_post_view_form_add"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='blog_id']" position="after">
                <field name="course_id"/>
            </xpath>
        </field>
    </record>
</odoo>

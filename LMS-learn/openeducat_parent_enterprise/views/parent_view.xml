<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_parent_inherited_form_view" model="ir.ui.view">
        <field name="name">op.parent.view.form.inherit</field>
        <field name="model">op.parent</field>
        <field name="inherit_id" ref="openeducat_parent.view_op_parent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="company_id"
                       groups="base.group_multi_company"/>
            </xpath>
            <xpath expr="//field[@name='relationship_id']" position="after">
                <field name="tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//form/sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="view_op_list_onboarding_parent" model="ir.ui.view">
        <field name="name">op.parent.view.list.inherit</field>
        <field name="model">op.parent</field>
        <field name="inherit_id" ref="openeducat_parent.view_op_parent_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_ids']" position="after">
                <field name="tag_ids"
                       widget="many2many_tags"
                       optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

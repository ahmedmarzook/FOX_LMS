<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_assign_grade_config_list" model="ir.ui.view">
        <field name="name">op.assign.grade.config.list</field>
        <field name="model">op.assign.grade.config</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list>
                <field name="grade"/>
            </list>
        </field>
    </record>

    <record id="view_op_assign_grade_config_form" model="ir.ui.view">
        <field name="name">op.assign.grade.config.form</field>
        <field name="model">op.assign.grade.config</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Grade Configuration">
                <sheet>
                    <group>
                        <field name="grade"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="act_op_assign_grade_config_view"
            model="ir.actions.act_window">
        <field name="name">Grade Configuration</field>
        <field name="res_model">op.assign.grade.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="act_op_assign_grade_config_view_list"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_assign_grade_config_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="view_op_assign_grade_config_list"/>
    </record>

    <record id="act_op_assign_grade_config_view_form"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_assign_grade_config_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_op_assign_grade_config_form"/>
    </record>
</odoo>

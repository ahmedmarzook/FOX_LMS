<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_assign_sub_line_inherit_list"
            model="ir.ui.view">
        <field name="name">op.assignment.sub.line.grading.enterprise.list</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_sub_line_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="grades_id"
                       optional="hide"
                       invisible="not evaluation_boolean"/>
                <field name="evaluation_boolean"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_assign_sub_line_inherit_form"
            model="ir.ui.view">
        <field name="name">op.assignment.sub.line.grading.enterprise.form</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_sub_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='marks']" position="after">
                <field name="evaluation_boolean" invisible="1"/>
                <field name="grades_id"
                       required="evaluation_boolean"
                       invisible="not evaluation_boolean"/>
            </xpath>

            <xpath expr="//field[@name='marks']" position="attributes">
                <attribute name="invisible">
                    evaluation_boolean or not assignment_id
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_op_assign_inherit_list"
            model="ir.ui.view">
        <field name="name">op.assignment.grading.enterprise.list</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="evaluation_type" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_assign_inherit_form"
            model="ir.ui.view">
        <field name="name">op.assignment.grading.enterprise.form</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='submission_date']" position="after">
                <field name="evaluation_type"/>
            </xpath>

            <xpath expr="//field[@name='marks']" position="attributes">
                <attribute name="invisible">
                    evaluation_type == 'grade'
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>

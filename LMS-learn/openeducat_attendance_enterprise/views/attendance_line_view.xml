<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_student_attendance_progress_form" model="ir.ui.view">
        <field name="name">op.attendance.line.form.enterprise</field>
        <field name="model">op.attendance.line</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_line_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attendance_id']" position="after">
                <field name="progression_id"/>
            </xpath>
            <xpath expr="//field[@name='course_id']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_student_attendance_progress_tree" model="ir.ui.view">
        <field name="name">op.attendance.line.list.enterprise</field>
        <field name="model">op.attendance.line</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_line_tree"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="after">
                <field name="progression_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_attendance_line_pivot_enterprise" model="ir.ui.view">
        <field name="name">op.attendance.line.pivot.enterprise</field>
        <field name="model">op.attendance.line</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Line Analysis">
                <field name="student_id" type="row"/>
                <field name="attendance_date" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="act_attendance_analysis_line_pivot_view" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">op.attendance.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_op_attendance_line_pivot_enterprise"/>
    </record>

    <record id="op_attendance_analysis_line_pivot_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_op_attendance_line_pivot_enterprise"/>
        <field name="act_window_id" ref="act_attendance_analysis_line_pivot_view"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_student_progress_tree" model="ir.ui.view">
        <field name="name">op.student.progression.list</field>
        <field name="model">op.student.progression</field>
        <field name="arch" type="xml">
            <list string="Student Progression">
                <field name="name" optional="hide"/>
                <field name="student_id"/>
                <field name="date"/>
                <field name="created_by"/>
                <field name="state"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_student_progress_form" model="ir.ui.view">
        <field name="name">op.student.progression.form</field>
        <field name="model">op.student.progression</field>
        <field name="arch" type="xml">
            <form string="Student Progression">
                <header>
                    <button name="state_draft" type="object" string="Reset To Draft"
                            class="oe_highlight"
                            invisible="state in ['draft', 'done']"/>
                    <button name="state_open" type="object" string="In Progress"
                            class="oe_highlight"
                            invisible="state in ['open', 'done', 'cancel']"/>
                    <button name="state_rejected" type="object" string="Cancel"
                            invisible="state in ['draft', 'done', 'cancel']"/>
                    <button name="state_done" type="object" string="Done"
                            class="oe_highlight"
                            invisible="state in ['draft', 'done', 'cancel']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,done,cancel"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group name="StudentData">
                        <group>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="created_by" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_op_student_progression_search" model="ir.ui.view">
        <field name="name">op.student.progression.search</field>
        <field name="model">op.student.progression</field>
        <field name="arch" type="xml">
            <search string="Progression Records">
                <field name="student_id"/>
                <field name="date"/>
                <field name="created_by"/>
                <field name="state"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_op_student_progression_graph" model="ir.ui.view">
        <field name="name">op.student.progression.graph</field>
        <field name="model">op.student.progression</field>
        <field name="arch" type="xml">
            <graph string="Student Progression" type="pie">
                <field name="student_id" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <record id="view_op_student_progression_pivot" model="ir.ui.view">
        <field name="name">op.student.progression.pivot</field>
        <field name="model">op.student.progression</field>
        <field name="arch" type="xml">
            <pivot string="Student Progression Analysis">
                <field name="student_id" type="row"/>
                <field name="state" type="col"/>
                <field name="date" type="col" interval="month"/>
            </pivot>
        </field>
    </record>

    <record id="action_student_progrss_analysis" model="ir.actions.act_window">
        <field name="name">Student Progression</field>
        <field name="res_model">op.student.progression</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_op_student_progression_search"/>
    </record>

    <record id="action_student_progrss_analysis_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_student_progrss_analysis"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_student_progress_tree"/>
    </record>

    <record id="action_student_progrss_analysis_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_student_progrss_analysis"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_student_progress_form"/>
    </record>

    <record id="act_op_student_progress_analysis_pivot_view" model="ir.actions.act_window">
        <field name="name">Student Progress Analysis</field>
        <field name="res_model">op.student.progression</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" ref="view_op_student_progression_pivot"/>
        <field name="search_view_id" ref="view_op_student_progression_search"/>
    </record>

    <record id="op_student_progress_analysis_pivot_view" model="ir.actions.act_window.view">
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_op_student_progression_pivot"/>
        <field name="act_window_id" ref="act_op_student_progress_analysis_pivot_view"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="approval_transfer_wizard_inherit" model="ir.ui.view">
            <field name="name">approval.transfer.wizard</field>
            <field name="model">approval.transfer.wizard</field>
            <field name="inherit_id" ref="eds_workflow.view_approval_transfer_wizard"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="approval_state_ids" invisible="1"/>
                    <field name="approval_state_id" widget="selection" required="1" domain="[('id', 'in', approval_state_ids)]"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="approval_return_wizard_inherit" model="ir.ui.view">
            <field name="name">approval.return.wizard</field>
            <field name="model">approval.return.wizard</field>
            <field name="inherit_id" ref="eds_workflow.view_approval_return_wizard"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="approval_state_ids" invisible="1"/>
                    <field name="approval_state_id" invisible="context.get('fixed_return_state')" widget="selection" required="not context.get('fixed_return_state')" domain="[('id', 'in', approval_state_ids)]"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
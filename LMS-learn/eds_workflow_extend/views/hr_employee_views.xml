<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 
        Note: Form view inheritance removed to avoid validation conflicts with 
        fields added by other modules (e.g., latest_contract_id from jes_holidays).
        
        The workflow_department_id field can be added to forms via:
        1. Odoo Studio
        2. A module that depends on jes_holidays
        3. Manual XML in a higher-level module
        
        The field is still available in list view and search filters below.
        -->

        <!-- Add workflow_department_id to employee list view for easy visibility -->
        <record id="view_employee_tree_workflow_department" model="ir.ui.view">
            <field name="name">hr.employee.tree.workflow.department</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="workflow_department_id" optional="hide"/>
                </xpath>
            </field>
        </record>
        <!-- Add search filter for employees with different workflow department -->
        <record id="view_employee_filter_workflow_department" model="ir.ui.view">
            <field name="name">hr.employee.search.workflow.department</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_department']" position="after">
                    <filter string="Has Workflow Department" 
                            name="has_workflow_dept"
                            domain="[('workflow_department_id', '!=', False)]"/>
                    <separator/>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="workflow_department_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-name="eds_user_audit.record_info">
    <table class="table table-condensed table-striped">
        <tr>
            <th>ID:</th>
            <td><t t-esc="data.id"/></td>
        </tr>
        <tr>
            <th>Name:</th>
            <td><t t-esc="data.name"/></td>
        </tr>        
        <tr t-if="data.xmlid and session.is_system">
            <th>XML ID:</th>
            <td>
            	<span id="record_xmlid"><t t-esc="data.xmlid"/></span>
            	<button class="btn btn-copy-xmlid fa fa-copy" t-att-data-clipboard-text="data.xmlid"></button>
            </td>
        </tr>
        <tr t-if="data.xmlid and session.is_system">
            <th>No Update:</th>
            <td><t t-esc="data.noupdate"/></td>
        </tr>
        <tr t-if="data.create_uid">
            <th>Creation By:</th>
            <td>
            	<t t-esc="data.create_uid"/>
            	<t t-esc="' - '"/>
            	<t t-esc="data.create_date"/>
            </td>
        </tr>
        <tr t-if="data.write_uid">
            <th>Latest Modification:</th>
            <td>
            	<t t-esc="data.write_uid"/>
            	<t t-esc="' - '"/>
            	<t t-esc="data.write_date"/>
            </td>
        </tr>        
    </table>
    <div>
	    <t t-if="data.lines[0]">
	    	<table class="table table-condensed table-striped">
	    		<thead>
	    			<tr>
	    				<th>Date</th>
	    				<th>User</th>
	    				<th>Field</th>
	    				<th>Old Value</th>
	    				<th>New Value</th>
	    			</tr>
	    		</thead>
	    		<tbody>
	    			<tr t-foreach="data.lines" t-as="line">
	    				<td><t t-esc="line.date"/></td>
	    				<td><t t-esc="line.user"/></td>
	    				<td><t t-esc="line.field"/></td>
	    				<td><t t-esc="line.old_value"/></td>
	    				<td><t t-esc="line.new_value"/></td>
	    			</tr>
	    		</tbody>
	    	</table>
	    </t>
    </div>
</t>

</templates>
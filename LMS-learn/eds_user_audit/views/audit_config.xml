<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_audit_config_form" model="ir.ui.view">
		<field name="name">audit.config.form</field>
		<field name="model">audit.config</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_button_box" name="button_box"/>				
					<widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
					<group>
						<group>
							<field name="active" invisible="1"/>
							<field name="name" />
							<field name="full_log" invisible="on_write == False" />
						</group>
						<group>
							<field name="on_read" />
							<field name="on_write" />
							<field name="on_create" />
							<field name="on_unlink" />
						</group>
					</group>
					<group string="Users">
						<field name="all_user" />
					</group>
					<group>
						<field name="user_ids" nolabel="0" string="" invisible="all_user == True"  />
					</group>
					<group string="Objects">
						<field name="model_ids" nolabel="0" string="" />
					</group>
					<group string="Fields" invisible="on_read != True and  on_write != True" >
						<field name="field_ids"  nolabel="0" string=""/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_audit_config_tree" model="ir.ui.view">
		<field name="name">audit.config.tree</field>
		<field name="model">audit.config</field>
		<field name="arch" type="xml">
			<list string="Audit Config Tree">
				<field name="name" />
				<field name="model_ids" />
				<field name="on_read" />
				<field name="on_write" />
				<field name="on_create" />
				<field name="on_unlink" />
			</list>
		</field>
	</record>

	<record id="view_audit_config_search" model="ir.ui.view">
		<field name="name">audit.config.search</field>
		<field name="model">audit.config</field>
		<field name="arch" type="xml">
			<search>
				<field name="name" />
				<filter name="inactive" string="Archived" domain="[('active','=', False)]" />
			</search>
		</field>
	</record>

</odoo>
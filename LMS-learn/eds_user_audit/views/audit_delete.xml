<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_audit_delete_form" model="ir.ui.view">
		<field name="name">audit.delete.form</field>
		<field name="model">audit.delete</field>
		<field name="arch" type="xml">
			<form string="Clear Audit Log">
				<sheet>
					<group>
						<field name="table_size" />
						<field name="record_count" />
						<field name="records_to_delete" />
					</group>					
					<group>
						<field name="date" />
						<field name="type_ids" widget="many2many_checkboxes" />
					</group>
					<group string="Objects">
						<field name="models_ids" nolabel="0" string="" />
					</group>
				</sheet>
				<footer>
					<button string='Clear Log' name="process" type="object" class="btn-primary" />
					<button string="Cancel" class="btn-default" special="cancel" />
				</footer>
			</form>
		</field>
	</record>

</odoo>
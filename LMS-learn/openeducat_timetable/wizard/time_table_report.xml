<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_time_table_report_form" model="ir.ui.view">
            <field name="name">time.table.report.form</field>
            <field name="model">time.table.report</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Timetable Report">
                    <sheet>
                        <group string="Report Information">
                            <group>
                                <field name="start_date"/>
                                <field name="state"/>
                                <field name="faculty_id"
                                       required="state == 'faculty'"
                                       invisible="state != 'faculty'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="end_date"/>
                                <field name="course_id"
                                       required="state == 'student'"
                                       invisible="state != 'student'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="batch_id"
                                       context="{'course_id': course_id, 'get_parent_batch': 1}"
                                       required="state == 'student'"
                                       invisible="state != 'student'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Print"
                                type="object"
                                name="gen_time_table_report"
                                class="oe_highlight"/>
                        <button special="cancel" string="Close" type="object"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_time_table_report_view">
            <field name="name">Generate Sessions Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">time.table.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>

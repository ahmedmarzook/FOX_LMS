<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_scholarship_kanban" model="ir.ui.view">
        <field name="name">op.scholarship.kanban</field>
        <field name="model">op.scholarship</field>
        <field name="arch" type="xml">
            <kanban default_group_by="scholarship_stages_id">
                <field name="scholarship_stages_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div class="mt-2">
                                <span class="fw-bold">Student:</span>
                                <field name="student_id"/>
                            </div>
                            <div>
                                <span class="fw-bold">Type:</span>
                                <field name="type_id"/>
                            </div>
                            <div>
                                <span class="fw-bold">Amount:</span>
                                <field name="amount" widget="monetary"/>
                            </div>
                            <div t-if="record.course_id.raw_value">
                                <span class="fw-bold">Course:</span>
                                <field name="course_id"/>
                            </div>
                            <div t-if="record.batch_id.raw_value">
                                <span class="fw-bold">Batch:</span>
                                <field name="batch_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_op_scholarship_list" model="ir.ui.view">
        <field name="name">op.scholarship.list</field>
        <field name="model">op.scholarship</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="type_id"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="show"/>
                <field name="sponsor_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="scholarship_stages_id"/>
                <field name="amount" widget="monetary" optional="show"/>
                <field name="invoice_id" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_op_scholarship_form" model="ir.ui.view">
        <field name="name">op.scholarship.form</field>
        <field name="model">op.scholarship</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Scholarship">
                <header>
                    <field name="scholarship_stages_id"
                           widget="statusbar"
                           options="{'clickable': true}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="make_invoices"
                                icon="fa-file-text-o"
                                invisible="not sponsor_id or amount &lt;= 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>

                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="batch_id"
                                   domain="[('course_id', '=', course_id)]"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="type_id"/>
                            <field name="sponsor_id"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_op_scholarship_search" model="ir.ui.view">
        <field name="name">op.scholarship.search</field>
        <field name="model">op.scholarship</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Scholarship">
                <field name="name"/>
                <field name="student_id"/>
                <field name="type_id"/>
                <field name="sponsor_id"/>
                <filter string="Archived"
                        name="inactive"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Student"
                        name="group_by_schol_student"
                        domain="[]"
                        context="{'group_by': 'student_id'}"/>
                <filter string="Type"
                        name="group_by_schol_type"
                        domain="[]"
                        context="{'group_by': 'type_id'}"/>
                <filter string="Stage"
                        name="group_by_schol_stage"
                        domain="[]"
                        context="{'group_by': 'scholarship_stages_id'}"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_open_op_scholarship_view">
        <field name="name">Scholarships</field>
        <field name="res_model">op.scholarship</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_op_scholarship_search"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_op_scholarship_view_form">
        <field name="act_window_id" ref="act_open_op_scholarship_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_op_scholarship_form"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_op_scholarship_view_list">
        <field name="act_window_id" ref="act_open_op_scholarship_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_op_scholarship_list"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_op_scholarship_stages_view_kanban">
        <field name="act_window_id" ref="act_open_op_scholarship_view"/>
        <field name="sequence" eval="5"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_scholarship_kanban"/>
    </record>
</odoo>

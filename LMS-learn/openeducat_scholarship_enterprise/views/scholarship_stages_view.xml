<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_scholarship_stages_form" model="ir.ui.view">
        <field name="name">scholarship.stage.form</field>
        <field name="model">scholarship.stages</field>
        <field name="arch" type="xml">
            <form string="Scholarship Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="fold"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_op_scholarship_stages_list" model="ir.ui.view">
        <field name="name">scholarship.stage.list</field>
        <field name="model">scholarship.stages</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_open_op_scholarship_stages_view">
        <field name="name">Scholarship Stages</field>
        <field name="res_model">scholarship.stages</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_op_scholarship_stages_view_form">
        <field name="act_window_id" ref="act_open_op_scholarship_stages_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_op_scholarship_stages_form"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_op_scholarship_stages_view_list">
        <field name="act_window_id" ref="act_open_op_scholarship_stages_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_op_scholarship_stages_list"/>
    </record>
</odoo>

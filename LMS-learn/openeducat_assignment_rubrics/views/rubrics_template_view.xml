<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_rubrics_template_config_list"
            model="ir.ui.view">
        <field name="name">op.rubric.template.list</field>
        <field name="model">op.rubric.template</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rubrics_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_op_rubrics_template_config_form"
            model="ir.ui.view">
        <field name="name">op.rubric.template.form</field>
        <field name="model">op.rubric.template</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Rubrics Template Configuration">
                <header>
                    <button name="act_re_open"
                            type="object"
                            string="Re-open"
                            class="btn-primary"
                            invisible="state != 'cancel'"/>
                    <button name="act_in_use"
                            type="object"
                            string="In Use"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="act_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state not in ('draft', 'in_use')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_use,cancel"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rubrics_type"
                               readonly="state == 'in_use'"/>
                    </group>

                    <notebook>
                        <page string="Rubric Elements"
                              name="rubric_element_line">
                            <field name="rubric_element_line"
                                   readonly="state == 'in_use'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="rubrics_type"
                                           column_invisible="1"/>
                                    <field name="point"
                                           invisible="rubrics_type != 'points'"/>
                                    <field name="percentage"
                                           invisible="rubrics_type != 'percent'"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="rubrics_template_id"
                                               invisible="1"/>
                                        <field name="rubrics_type"
                                               invisible="1"/>
                                        <field name="description"
                                               invisible="rubrics_type != 'no_points'"/>
                                        <field name="point"
                                               invisible="rubrics_type != 'points'"/>
                                        <field name="percentage"
                                               invisible="rubrics_type != 'percent'"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="act_op_rubric_template_config_view"
            model="ir.actions.act_window">
        <field name="name">Rubrics Template</field>
        <field name="res_model">op.rubric.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="act_op_rubric_template_view_list"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_rubric_template_config_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="view_op_rubrics_template_config_list"/>
    </record>

    <record id="act_op_rubric_template_view_form"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_rubric_template_config_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_op_rubrics_template_config_form"/>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_rubrics_element_config_list"
            model="ir.ui.view">
        <field name="name">op.rubric.element.list</field>
        <field name="model">op.rubric.element</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rubrics_type"/>
                <field name="rubrics_template_id" optional="hide"/>
                <field name="point" optional="hide"/>
                <field name="percentage" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_op_rubrics_element_config_form"
            model="ir.ui.view">
        <field name="name">op.rubric.element.form</field>
        <field name="model">op.rubric.element</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Rubrics Elements Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rubrics_template_id"/>
                            <field name="rubrics_type" invisible="1"/>
                        </group>
                        <group>
                            <field name="description"
                                   invisible="rubrics_type != 'no_points'"/>
                            <field name="point"
                                   invisible="rubrics_type != 'points'"/>
                            <field name="percentage"
                                   invisible="rubrics_type != 'percent'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="act_op_rubric_element_config_view"
            model="ir.actions.act_window">
        <field name="name">Rubrics Element</field>
        <field name="res_model">op.rubric.element</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="act_op_rubric_element_config_view_list"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_rubric_element_config_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="view_op_rubrics_element_config_list"/>
    </record>

    <record id="act_op_rubric_element_config_view_form"
            model="ir.actions.act_window.view">
        <field name="act_window_id"
               ref="act_op_rubric_element_config_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_op_rubrics_element_config_form"/>
    </record>
</odoo>

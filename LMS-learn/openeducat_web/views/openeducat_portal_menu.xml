<odoo>
    <record id="portal_menu_tree" model="ir.ui.view">
        <field name="name">portal.menu.list</field>
        <field name="model">openeducat.portal.menu</field>
        <field name="arch" type="xml">
            <list string="Portal Menus" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="link"/>
                <field name="website_id"/>
                <field name="is_visible_to_student"/>
                <field name="is_visible_to_parent"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="portal_menu_form" model="ir.ui.view">
        <field name="name">portal.menu.form</field>
        <field name="model">openeducat.portal.menu</field>
        <field name="arch" type="xml">
            <form string="Portal Menu">
                <sheet>
                    <group>
                        <group string="Menu Information">
                            <field name="name"/>
                            <field name="link"/>
                            <field name="sequence"/>
                            <field name="website_id"/>
                            <field name="menu_ref_name"/>
                        </group>

                        <group string="Visibility">
                            <field name="active"/>
                            <field name="is_visible_to_student"/>
                            <field name="is_visible_to_parent"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group string="Design">
                        <group>
                            <field name="icon_code"/>
                            <field name="background_color"/>
                        </group>
                        <group>
                            <field name="icon_image" widget="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="portal_menu_search" model="ir.ui.view">
        <field name="name">portal.menu.search</field>
        <field name="model">openeducat.portal.menu</field>
        <field name="arch" type="xml">
            <search string="Portal Menu">
                <field name="name"/>
                <field name="link"/>
                <field name="website_id"/>
            </search>
        </field>
    </record>


    <record id="action_portal_menu_configuration" model="ir.actions.act_window">
        <field name="name">Portal Menu</field>
        <field name="res_model">openeducat.portal.menu</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="portal_menu_tree"/>
        <field name="search_view_id" ref="portal_menu_search"/>
        <field name="target">current</field>
    </record>


    <menuitem id="portal_menu_dashboard"
              name="Portal menu"
              parent="openeducat_core.menu_op_school_config"
              action="action_portal_menu_configuration"
              sequence="45"
              groups="openeducat_core.group_op_back_office_admin"/>


</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_classroom_inherited_form_view" model="ir.ui.view">
        <field name="name">op.classroom.form.inherit.company</field>
        <field name="model">op.classroom</field>
        <field name="inherit_id" ref="openeducat_classroom.view_op_classroom_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='batch_id']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_op_classroom_inherited_list_view" model="ir.ui.view">
        <field name="name">op.classroom.list.inherit.company</field>
        <field name="model">op.classroom</field>
        <field name="inherit_id" ref="openeducat_classroom.view_op_classroom_tree"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

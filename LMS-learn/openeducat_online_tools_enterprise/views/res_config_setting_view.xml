<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_online_meeting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.online.meeting</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="OpenEduCat"
                     name="openeducat_online_tools_enterprise">
                    <block title="Online Tools Integration"
                           name="openeducat_online_tools_settings">
                        <setting string="Automatic Email"
                                 help="Automatically send email notifications for online meetings.">
                            <field name="automatic_email"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_op_course_attach_url_wizard_form" model="ir.ui.view">
        <field name="name">op.course.attach.url.wizard.form</field>
        <field name="model">op.course.attach.url.wizard</field>
        <field name="arch" type="xml">

            <form string="Attach Course Files">

                <group>

                    <field name="course_id" invisible="1"/>

                    <field name="attachment_type"
                           widget="radio"/>

                    <field name="name"
                           placeholder="Attachment title"/>

                    <!-- File -->
                    <field name="datas"
                           filename="filename"
                           invisible="attachment_type != 'file'"/>

                    <field name="filename"
                           invisible="1"/>

                    <!-- URL -->
                    <field name="url"
                           placeholder="https://..."
                           invisible="attachment_type != 'url'"/>

                </group>

                <footer>

                    <button name="action_confirm"
                            string="Attach"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: add Doctor Name right after Name -->
    <record id="view_op_lms_course_tree_doctor_name" model="ir.ui.view">
        <field name="name">op.course.list.lms.doctor.name</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_lms.view_op_lms_course_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="doctor_name" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Form view: add Doctor Name right after Name -->
    <record id="view_op_lms_course_form_doctor_name" model="ir.ui.view">
        <field name="name">op.course.form.lms.doctor.name</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_lms.view_op_lms_course_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[contains(@class, 'oe_title')]" position="after">
                <group col="2">
                    <field name="doctor_name" string="Doctor Name"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Form view: remove Thumbnail and show Attach Course Files as one button -->
    <record id="view_op_lms_course_form_attachments" model="ir.ui.view">
        <field name="name">op.course.form.lms.attachments</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_lms.view_op_lms_course_form"/>
        <field name="arch" type="xml">

            <!-- Remove Thumbnail completely -->
            <xpath expr="//group[field[@name='thumbnail_type']]" position="replace"/>

            <!-- Add Attach Course Files as a single button -->
            <xpath expr="//notebook" position="before">

                <button name="action_add_attachment_url"
                        string="Attach Course Files"
                        type="object"
                        icon="fa-paperclip"
                        class="btn-primary"/>

                <field name="course_attachment_ids"
                       string="Course Files"
                       nolabel="1">
                    <list>
                        <field name="name" string="File"/>
                        <field name="description" string="Title"/>
                        <field name="type" string="Type"/>
                    </list>
                </field>

            </xpath>

        </field>
    </record>

</odoo>

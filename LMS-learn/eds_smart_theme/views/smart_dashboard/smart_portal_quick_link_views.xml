<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_portal_quick_link_tree" model="ir.ui.view">
        <field name="name">smart.portal.quick.link.tree</field>
        <field name="model">smart.portal.quick.link</field>
        <field name="arch" type="xml">
            <list string="Quick links" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="link_url"/>
            </list>
        </field>
    </record>

    <record id="view_smart_portal_quick_link_form" model="ir.ui.view">
        <field name="name">smart.portal.quick.link.form</field>
        <field name="model">smart.portal.quick.link</field>
        <field name="arch" type="xml">
            <form string="Quick link">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="link_url" placeholder="https://example.com or /web#action=..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_portal_quick_link" model="ir.actions.act_window">
        <field name="name">Quick links</field>
        <field name="res_model">smart.portal.quick.link</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add links for the Smart Services Portal quick-links bar.</p>
        </field>
    </record>

    <menuitem id="menu_smart_portal_root" name="Smart Portal" sequence="45"
              parent="base.menu_administration"/>
    <menuitem id="menu_smart_portal_quick_links" name="Quick links"
              parent="menu_smart_portal_root" action="action_smart_portal_quick_link" sequence="10"/>
</odoo>

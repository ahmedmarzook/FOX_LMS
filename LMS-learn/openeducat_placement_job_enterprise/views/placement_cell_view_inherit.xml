<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_placement_cell_inherit_kanban" model="ir.ui.view">
        <field name="name">op.placement.cell.inherit.kanban</field>
        <field name="model">op.placement.cell</field>
        <field name="inherit_id"
               ref="openeducat_placement_enterprise.view_op_placement_cell_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/div" position="inside">
                <div class="mt-3">
                    <button class="btn btn-primary"
                            name="%(act_open_activity_announcement_view)d"
                            type="action">
                        Announcements
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

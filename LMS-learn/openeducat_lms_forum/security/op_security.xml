<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="forum_post_lms_rule" model="ir.rule">
        <field name="name">LMS Forum Posts</field>
        <field name="model_id" ref="website_forum.model_forum_post"/>
        <field name="groups" eval="[(4, ref('openeducat_lms.group_op_lms_user'))]"/>
        <field name="domain_force">['|', '|', ('course_id', '=', False), ('course_id.enrollment_user_ids', 'in', [user.id]), ('course_id.user_id', '=', user.id)]</field>
    </record>
</odoo>

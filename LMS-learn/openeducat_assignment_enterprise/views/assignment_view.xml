<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_op_assignment_enterprise_inherited_list_view"
            model="ir.ui.view">
        <field name="name">op.assignment.enterprise.inherited.list</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="attempt_type" optional="hide"/>
                <field name="max_attempt" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_op_assignment_inherited_form_view"
            model="ir.ui.view">
        <field name="name">op.assignment.enterprise.inherited.form</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='reviewer']" position="after">
                <field name="company_id"
                       groups="base.group_multi_company"/>
            </xpath>

            <xpath expr="//notebook" position="before">
                <group string="Submission Details">
                    <group>
                        <field name="attempt_type"
                               readonly="state != 'draft'"/>
                    </group>
                    <group>
                        <field name="max_attempt"
                               readonly="state != 'draft'"
                               invisible="attempt_type == 'single'"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook/page[@name='submissions']"
                   position="after">
                <page name="additional_submission_configuration"
                      string="Student Additional Attempt"
                      invisible="attempt_type == 'single'">

                    <field name="additional_attempt" nolabel="1">
                        <list>
                            <field name="assignment_id"/>
                            <field name="student_id"/>
                            <field name="datetime"/>
                            <field name="allowed_attempt"/>
                            <field name="create_by"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

    <record id="view_op_assignment_inherited_search_view"
            model="ir.ui.view">
        <field name="name">op.assignment.enterprise.inherited.search</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="subject_id"
                           icon="fa-book"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_op_list_onboarding_assignment"
            model="ir.ui.view">
        <field name="name">op.assignment.onboarding.list</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id"
               ref="openeducat_assignment.view_op_assignment_list"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </xpath>

        </field>
    </record>

    <record id="view_op_assignment_pivot_enterprise"
            model="ir.ui.view">
        <field name="name">op.assignment.pivot.enterprise</field>
        <field name="model">op.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Assignment Analysis">
                <field name="course_id" type="row"/>
                <field name="subject_id" type="row"/>
                <field name="batch_id" type="col"/>
                <field name="marks" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="act_assignment_analysis_pivot_view"
            model="ir.actions.act_window">
        <field name="name">Assignment Analysis</field>
        <field name="res_model">op.assignment</field>
        <field name="view_mode">pivot</field>
        <field name="view_id"
               ref="view_op_assignment_pivot_enterprise"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="view_op_assignment_sub_line_pivot_enterprise"
            model="ir.ui.view">
        <field name="name">op.assignment.sub.line.pivot.enterprise</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="arch" type="xml">
            <pivot string="Assignment Submission Analysis">
                <field name="student_id" type="row"/>
                <field name="state" type="col"/>
                <field name="marks" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="act_assignment_submission_pivot_view"
            model="ir.actions.act_window">
        <field name="name">Assignment Submission Analysis</field>
        <field name="res_model">op.assignment.sub.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id"
               ref="view_op_assignment_sub_line_pivot_enterprise"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
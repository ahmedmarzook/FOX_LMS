<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_op_attendance_sheet_tree" model="ir.ui.view">
            <field name="name">op.attendance.sheet.list</field>
            <field name="model">op.attendance.sheet</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Attendance Sheets">
                    <field name="register_id"/>
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="attendance_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_op_attendance_sheet_form" model="ir.ui.view">
            <field name="name">op.attendance.sheet.form</field>
            <field name="model">op.attendance.sheet</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Attendance Sheet">
                    <header>
                        <button type="object" name="attendance_start"
                                invisible="state != 'draft'"
                                string="Attendance Start"
                                class="oe_highlight"/>

                        <button type="object" name="attendance_done"
                                invisible="state != 'start'"
                                string="Attendance Taken"
                                class="oe_highlight"/>

                        <button type="object" name="attendance_draft"
                                invisible="state != 'cancel'"
                                string="Draft"
                                class="oe_highlight"/>

                        <button type="object" name="attendance_cancel"
                                invisible="state not in ['draft', 'start']"
                                string="Cancel"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,start,done,cancel"/>
                    </header>

                    <sheet>
                        <field name="active" invisible="1"/>

                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>

                        <div name="button_box" class="oe_button_box"/>

                        <group string="Attendance Sheet Information">
                            <group>
                                <field name="register_id" required="1"/>
                                <field name="session_id"/>
                                <field name="course_id" invisible="1"/>
                                <field name="batch_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="name"/>
                                <field name="attendance_date"/>
                            </group>
                        </group>

                        <group string="Students">
                            <field name="attendance_line" nolabel="1">
                                <list string="Attendance Lines" editable="bottom">
                                    <field name="student_id"/>
                                    <field name="attendance_type_id"/>
                                    <field name="present"/>
                                    <field name="late"/>
                                    <field name="excused"/>
                                    <field name="absent"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </group>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_attendance_sheet_search" model="ir.ui.view">
            <field name="name">op.attendance.sheet.search</field>
            <field name="model">op.attendance.sheet</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Attendance Sheets">
                    <field name="name"/>
                    <field name="register_id"/>
                    <field name="session_id"/>
                    <field name="attendance_date"/>
                    <field name="state"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_attendance_sheet_view">
            <field name="name">Attendance Sheets</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.attendance.sheet</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_op_attendance_sheet_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="target">current</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_attendance_sheet_view_tree">
            <field name="act_window_id" ref="act_open_op_attendance_sheet_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_attendance_sheet_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_attendance_sheet_view_form">
            <field name="act_window_id" ref="act_open_op_attendance_sheet_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_attendance_sheet_form"/>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_op_boarding_steps_kanban" model="ir.ui.view">
        <field name="name">oe.onboarding.steps.kanban</field>
        <field name="model">oe.onboarding.steps</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <kanban class="o_onboarding_kanban" create="false"
                    js_class="no_search_panel_onboarding">
                <field name="id"/>
                <field name="image"/>
                <field name="name"/>
                <field name="step_name"/>
                <field name="is_done"/>
                <field name="is_start"/>
                <field name="doc_link"/>
                <field name="youtube_link"/>
                <field name="plan_id"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click_css o_res_partner_kanban shadow"
                             t-attf-style="#{record.is_done.raw_value ? 'background-color: #fff3e080; border-color: #e9cfb6;' : 'background-color: #ffffff;'}">

                            <div class="button-link">

                                <t t-if="record.youtube_link.raw_value">
                                    <a role="button"
                                       t-attf-href="{{ record.youtube_link.raw_value }}"
                                       data-fancybox=""
                                       class="btn btn-primary oe_highlight view_button youtube_btn mt-0 mb-2">
                                        <i class="fa fa-youtube-play" title="youtube"/>
                                    </a>
                                </t>

                                <t t-if="record.doc_link.raw_value">
                                    <a t-attf-href="{{ record.doc_link.raw_value }}"
                                       role="button"
                                       target="_blank"
                                       class="btn btn-primary oe_highlight view_button mt-0 doc_button">
                                        <i class="fa fa-file-text-o" title="document"/>
                                    </a>
                                </t>

                            </div>

                            <div class="mb16 text-center">
                                <t t-if="record.image.raw_value">
                                    <img t-att-src="'/web/image/oe.onboarding.steps/%s/image' % record.id.raw_value"
                                         alt="step"
                                         class="mx-auto step-img"/>
                                </t>

                                <t t-else="">
                                    <img src="/web/static/img/placeholder.png"
                                         alt="step"
                                         class="mx-auto step-img"/>
                                </t>
                            </div>

                            <div class="oe_kanban_details" style="text-align:center;">
                                <strong>
                                    <field name="step_name"/>
                                </strong>
                            </div>

                            <div class="d-flex justify-content-center mt-2">

                                <button type="object"
                                        name="open_action_view"
                                        class="oe_highlight view_button start_btn mx-1">
                                    <i class="fa fa-power-off action-icon" title="power"/>
                                    <span class="ms-1">Start</span>
                                </button>

                                <button type="object"
                                        name="step_done"
                                        class="oe_highlight view_button done_btn mx-1"
                                        invisible="not is_start">
                                    <field name="is_done" invisible="1"/>
                                    <i class="fa fa-check-square-o action-icon" title="checkbox"/>
                                    <span class="ms-1">Mark as done</span>
                                </button>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_op_boarding_steps_list" model="ir.ui.view">
        <field name="name">oe.onboarding.steps.list</field>
        <field name="model">oe.onboarding.steps</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Onboarding Steps">
                <field name="name"/>
                <field name="step_name"/>
                <field name="plan_id"/>
                <field name="is_start"/>
                <field name="is_done"/>
                <field name="doc_link"/>
                <field name="youtube_link"/>
            </list>
        </field>
    </record>


    <record id="view_op_boarding_steps_form" model="ir.ui.view">
        <field name="name">oe.onboarding.steps.form</field>
        <field name="model">oe.onboarding.steps</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Onboarding Step">
                <sheet>

                    <group>
                        <group string="Step Information">
                            <field name="name" readonly="1"/>
                            <field name="step_name"/>
                            <field name="plan_id"/>
                            <field name="action_id"/>
                        </group>

                        <group string="Status">
                            <field name="is_start"/>
                            <field name="is_done"/>
                        </group>
                    </group>

                    <group string="Media">
                        <field name="image" widget="image"/>
                    </group>

                    <group string="Links">
                        <field name="doc_link"/>
                        <field name="youtube_link"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id="view_op_boarding_steps_search" model="ir.ui.view">
        <field name="name">oe.onboarding.steps.search</field>
        <field name="model">oe.onboarding.steps</field>
        <field name="arch" type="xml">
            <search string="Onboarding Steps">
                <field name="name"/>
                <field name="step_name"/>
                <field name="plan_id"/>
            </search>
        </field>
    </record>


    <record id="act_op_boarding_steps" model="ir.actions.act_window">
        <field name="name">OnBoarding</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">oe.onboarding.steps</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_op_boarding_steps_search"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create onboarding steps.
            </p>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_token" model="ir.cron">
        <field name="name">Refresh Microsoft Teams Token</field>
        <field name="model_id" ref="model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">model.create({}).do_refresh_token()</field>
        <field name="interval_number">55</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>

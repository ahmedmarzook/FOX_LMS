<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Student Kanban View -->
        <record id="kanban_view_student" model="ir.ui.view">
            <field name="name">op.student.kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban class="o_res_partner_kanban">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="image_1920"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="email"/>
                    <field name="lang"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_res_partner_kanban">

                                <div class="o_kanban_image">
                                    <t t-if="record.image_1920.raw_value">
                                        <img t-att-src="'/web/image/op.student/%s/image_1920' % record.id.raw_value"
                                             alt="Student"/>
                                    </t>
                                    <t t-else="">
                                        <img src="/web/static/img/avatar.png" alt="Student"/>
                                    </t>
                                </div>

                                <div class="oe_kanban_details">
                                    <strong>
                                        <field name="name"/>
                                    </strong>

                                    <ul class="mt-2 mb-0 ps-3">
                                        <li t-if="record.phone.raw_value">
                                            <field name="phone"/>
                                        </li>

                                        <li t-if="record.mobile.raw_value">
                                            <field name="mobile"/>
                                        </li>

                                        <li t-if="record.email.raw_value">
                                            <a t-attf-href="mailto:#{record.email.raw_value}">
                                                <field name="email"/>
                                            </a>
                                        </li>

                                        <li t-if="record.lang.raw_value">
                                            <field name="lang"/>
                                        </li>
                                    </ul>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- Student List View -->
        <record id="view_op_student_tree" model="ir.ui.view">
            <field name="name">op.student.list</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Students">
                    <field name="title" optional="hide"/>
                    <field name="name"/>
                    <field name="gender" optional="show"/>
                    <field name="birth_date" optional="show"/>
                    <field name="gr_no" optional="show"/>
                    <field name="phone" optional="show"/>
                    <field name="mobile" optional="hide"/>
                    <field name="email" optional="show"/>
                    <field name="blood_group" optional="hide"/>
                    <field name="emergency_contact" optional="hide"/>
                    <field name="nationality" optional="hide"/>
                    <field name="lang" optional="hide"/>
                </list>
            </field>
        </record>


        <!-- Student Form View -->
        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Student">

                    <header>
                        <button type="object"
                                name="create_student_user"
                                string="Create Student User"
                                class="oe_highlight"
                                invisible="user_id"/>
                    </header>

                    <sheet>

                        <div name="button_box" class="oe_button_box"/>

                        <field name="active" invisible="1"/>

                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>

                        <group string="Student Basic Data">
                            <group>
                                <field name="image_1920"
                                       widget="image"
                                       class="oe_avatar"
                                       options="{'preview_image': 'image_1920'}"/>
                            </group>

                            <group>
                                <field name="name"
                                       string="Student Name"
                                       placeholder="Student Full Name"
                                       required="1"/>
                            </group>
                        </group>

                        <group string="Student Name Details">
                            <group>
                                <field name="title" placeholder="Title"/>
                                <field name="first_name" required="1" placeholder="First Name"/>
                                <field name="middle_name" placeholder="Middle Name"/>
                                <field name="last_name" placeholder="Last Name"/>
                            </group>

                            <group>
                                <field name="gr_no"/>
                                <field name="category_id"/>
                                <field name="user_id" string="User" readonly="1"/>
                                <field name="partner_id"
                                       placeholder="Partner"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </group>
                        </group>

                        <notebook>

                            <page name="personal_information" string="Personal Information">

                                <group>
                                    <group string="Basic Information">
                                        <field name="gender" required="1"/>
                                        <field name="birth_date" required="1"/>
                                        <field name="type"/>
                                        <field name="blood_group"/>
                                        <field name="nationality"
                                               options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="visa_info"/>
                                        <field name="lang"/>
                                    </group>

                                    <group string="Contact Information">
                                        <field name="email" required="1"/>
                                        <field name="phone" required="1"/>
                                        <field name="mobile"/>
                                        <field name="emergency_contact"
                                               context="{'show_address': 1}"
                                               options="{'no_create': True, 'no_create_edit': True}"/>
                                    </group>
                                </group>

                            </page>


                            <page name="address_information" string="Address">

                                <group>
                                    <group string="Address">
                                        <field name="street" placeholder="Street..."/>
                                        <field name="street2" placeholder="Street 2"/>
                                        <field name="city" placeholder="City"/>
                                        <field name="state_id"
                                               placeholder="State"
                                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                        <field name="zip" placeholder="ZIP"/>
                                        <field name="country_id"
                                               placeholder="Country"
                                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    </group>
                                </group>

                            </page>


                            <page name="miscellaneous" string="Miscellaneous">
                                <group>
                                    <group>
                                        <field name="gr_no"/>
                                    </group>
                                </group>
                            </page>

                        </notebook>

                    </sheet>

                    <!-- Odoo 19 Chatter -->
                    <chatter/>

                </form>
            </field>
        </record>


        <!-- Student Search View -->
        <record id="view_op_student_search" model="ir.ui.view">
            <field name="name">op.student.search</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Students">
                    <field name="name"/>
                    <field name="first_name"/>
                    <field name="middle_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="gr_no"/>
                </search>
            </field>
        </record>


        <!-- Student Main Action -->
        <record model="ir.actions.act_window" id="act_open_op_student_view">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_op_student_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="target">current</field>
        </record>


        <record model="ir.actions.act_window.view" id="act_open_op_student_view_kanban">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="kanban_view_student"/>
        </record>


        <record model="ir.actions.act_window.view" id="act_open_op_student_view_tree">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_student_tree"/>
        </record>


        <record model="ir.actions.act_window.view" id="act_open_op_student_view_form">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_student_form"/>
        </record>


        <!-- Secondary Student Action -->
        <record model="ir.actions.act_window" id="act_open_op_student_view_2">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_op_student_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Subject Registration List View -->
        <record id="view_subject_registration_tree" model="ir.ui.view">
            <field name="name">op.subject.registration.list</field>
            <field name="model">op.subject.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Subject Registration">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="min_unit_load" optional="hide"/>
                    <field name="max_unit_load" optional="hide"/>
                    <field name="compulsory_subject_ids" widget="many2many_tags" optional="hide"/>
                    <field name="elective_subject_ids" widget="many2many_tags" optional="hide"/>
                    <field name="state"/>
                </list>
            </field>
        </record>


        <!-- Subject Registration Form View -->
        <record id="view_subject_registration_form" model="ir.ui.view">
            <field name="name">op.subject.registration.form</field>
            <field name="model">op.subject.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Subject Registration">

                    <header>
                        <button name="action_submitted"
                                string="Submit"
                                groups="openeducat_core.group_op_back_office_admin,openeducat_core.group_op_faculty"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>

                        <button name="action_approve"
                                string="Approve"
                                groups="openeducat_core.group_op_faculty"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'submitted'"/>

                        <button name="action_reject"
                                string="Reject"
                                groups="openeducat_core.group_op_faculty"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'submitted'"/>

                        <button name="action_reset_draft"
                                string="Reset to Draft"
                                groups="openeducat_core.group_op_back_office_admin"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'rejected'"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,submitted,approved,rejected"/>
                    </header>

                    <sheet>

                        <div class="oe_title">
                            <label for="name"/>
                            <h2>
                                <field name="name" readonly="1"/>
                            </h2>
                        </div>

                        <group string="Registration Information">
                            <group>
                                <field name="student_id"
                                       required="1"
                                       options="{'no_create': True, 'no_create_edit': True}"/>

                                <field name="course_id"
                                       required="1"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>

                                <field name="batch_id"
                                       domain="[('course_id', '=', course_id)]"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>

                            <group>
                                <field name="min_unit_load" readonly="1"/>
                                <field name="max_unit_load" readonly="1"/>
                            </group>
                        </group>

                        <button name="get_subjects"
                                type="object"
                                string="Get Subjects"
                                class="oe_highlight mt-3"
                                invisible="state != 'draft'"/>

                        <notebook>
                            <page string="Compulsory Subjects" name="compulsory_subjects">
                                <field name="compulsory_subject_ids"
                                       widget="many2many_tags"
                                       readonly="1"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </page>

                            <page string="Elective Subjects" name="elective_subjects">
                                <field name="elective_subject_ids"
                                       widget="many2many_tags"
                                       domain="[('subject_type', '=', 'elective')]"
                                       readonly="state != 'draft'"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </page>
                        </notebook>

                    </sheet>

                    <!-- Odoo 19 Chatter -->
                    <chatter/>

                </form>
            </field>
        </record>


        <!-- Subject Registration Search View -->
        <record id="view_subject_registration_search" model="ir.ui.view">
            <field name="name">op.subject.registration.search</field>
            <field name="model">op.subject.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Subject Registration">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="state"/>
                </search>
            </field>
        </record>


        <!-- Subject Registration Graph View -->
        <record id="view_subject_registration_graph" model="ir.ui.view">
            <field name="name">op.subject.registration.graph</field>
            <field name="model">op.subject.registration</field>
            <field name="arch" type="xml">
                <graph string="Subject Registration Analysis" type="pie">
                    <field name="course_id" type="row"/>
                    <field name="state" type="col"/>
                </graph>
            </field>
        </record>


        <!-- Subject Registration Pivot View -->
        <record id="view_subject_registration_pivot" model="ir.ui.view">
            <field name="name">op.subject.registration.pivot</field>
            <field name="model">op.subject.registration</field>
            <field name="arch" type="xml">
                <pivot string="Subject Registration Analysis">
                    <field name="course_id" type="row"/>
                    <field name="batch_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="student_id" type="row"/>
                </pivot>
            </field>
        </record>


        <!-- Subject Registration Action -->
        <record model="ir.actions.act_window" id="act_subject_registration_view">
            <field name="name">Subject Registration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.subject.registration</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="search_view_id" ref="view_subject_registration_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="target">current</field>
        </record>


        <!-- Subject Registration Action List -->
        <record model="ir.actions.act_window.view" id="act_subject_registration_view_list">
            <field name="act_window_id" ref="act_subject_registration_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_subject_registration_tree"/>
        </record>


        <!-- Subject Registration Action Form -->
        <record model="ir.actions.act_window.view" id="act_subject_registration_view_form">
            <field name="act_window_id" ref="act_subject_registration_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_subject_registration_form"/>
        </record>


        <!-- Subject Registration Action Graph -->
        <record model="ir.actions.act_window.view" id="act_subject_registration_view_graph">
            <field name="act_window_id" ref="act_subject_registration_view"/>
            <field name="sequence" eval="30"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_subject_registration_graph"/>
        </record>


        <!-- Subject Registration Action Pivot -->
        <record model="ir.actions.act_window.view" id="act_subject_registration_view_pivot">
            <field name="act_window_id" ref="act_subject_registration_view"/>
            <field name="sequence" eval="40"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_subject_registration_pivot"/>
        </record>


        <!-- Sequence -->
        <record id="seq_op_subject_registration" model="ir.sequence">
            <field name="name">Subject Registration</field>
            <field name="code">op.subject.registration</field>
            <field name="prefix">SR</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
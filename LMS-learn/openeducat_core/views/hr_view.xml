<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_employee_form_openeducat_core" model="ir.ui.view">
            <field name="name">hr.employee.form.openeducat.core</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="OpenEduCat" name="openeducat_employee_page">
                            <group>
                                <field name="user_id"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>

            </field>
        </record>

    </data>
</odoo>